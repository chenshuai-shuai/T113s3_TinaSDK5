#!/bin/sh
#
# 开机自动连接 WiFi (AP6212 / brcmfmac)
# 优先用 UDISK 上的配置，便于换网络不刷机
#
IFACE=wlan0
CONF_UDISK=/mnt/UDISK/wifi/wpa_supplicant.conf
CONF_ETC=/etc/wpa_supplicant.conf
case "$1" in
start)
	printf "Starting wifi (%s): " "$IFACE"
	i=0
	while [ ! -e /sys/class/net/$IFACE ] && [ $i -lt 10 ]; do
		sleep 1
		i=$((i+1))
	done
	if [ ! -e /sys/class/net/$IFACE ]; then
		echo "FAIL (no $IFACE)"
		exit 1
	fi
	if [ -f "$CONF_UDISK" ]; then
		WPA_CONF=$CONF_UDISK
		echo -n "(using UDISK conf) "
	else
		WPA_CONF=$CONF_ETC
	fi
	mkdir -p /var/run/wpa_supplicant
	ifconfig $IFACE up
	wpa_supplicant -B -i $IFACE -c $WPA_CONF -D nl80211
	(
		i=0
		while [ $i -lt 30 ]; do
			if wpa_cli -i $IFACE status 2>/dev/null | grep -q "wpa_state=COMPLETED"; then
				udhcpc -i $IFACE -n -q -t 5 >/dev/null 2>&1
				break
			fi
			sleep 1
			i=$((i+1))
		done
	) &
	echo "OK"
	;;
stop)
	printf "Stopping wifi: "
	killall wpa_supplicant 2>/dev/null
	echo "OK"
	;;
restart|reload)
	"$0" stop
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
exit 0